{
  "name": "mrcp-vscode",
  "displayName": "MRCP Engine Integration",
  "description": "Visualizes the structural graph generated by the MRCP Engine",
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mrcp.analyze",
        "title": "MRCP: Analyze Repository"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.0.0"
  }
}
