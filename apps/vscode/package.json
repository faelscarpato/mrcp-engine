{
  "name": "mrcp-vscode",
  "displayName": "MRCP Engine — Deterministic AI Context & Code Health Cockpit",
  "description": "Deterministic repository intelligence, ultra-lean LLM context packing (95% token savings), AST security audit, cyclomatic health scoring, and architecture graph visualization.",
  "version": "2.5.0",
  "publisher": "mrcp-engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scarpatoweb/mrcp-engine.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mrcp",
    "ast",
    "token-reduction",
    "llm-context",
    "code-health",
    "architecture-graph",
    "security-audit",
    "ai-agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mrcp-explorer",
          "title": "MRCP Engine",
          "icon": "resources/mrcp-icon.svg"
        }
      ]
    },
    "views": {
      "mrcp-explorer": [
        {
          "id": "mrcp.views.quickActions",
          "name": "⚡ Ações Rápidas",
          "contextualTitle": "MRCP Quick Actions"
        },
        {
          "id": "mrcp.views.health",
          "name": "📊 Saúde & Métricas de Código",
          "contextualTitle": "MRCP Code Health"
        },
        {
          "id": "mrcp.views.security",
          "name": "🛡️ Segurança & Segredos (.env)",
          "contextualTitle": "MRCP Security & Secrets"
        },
        {
          "id": "mrcp.views.architecture",
          "name": "🏗️ Arquitetura & Dependências",
          "contextualTitle": "MRCP Architecture"
        },
        {
          "id": "mrcp.views.quality",
          "name": "🧪 Gaps de Testes & Código Morto",
          "contextualTitle": "MRCP Quality"
        },
        {
          "id": "mrcp.views.documents",
          "name": "📄 Inteligência Documental (DQI)",
          "contextualTitle": "MRCP Document Intelligence"
        }
      ]
    },
    "commands": [
      {
        "command": "mrcp.runFullSuite",
        "title": "MRCP: Executar Diagnóstico Completo (Full Suite)",
        "icon": "$(play)"
      },
      {
        "command": "mrcp.openDashboard",
        "title": "MRCP: Abrir Cockpit Interativo & Grafo AST",
        "icon": "$(dashboard)"
      },
      {
        "command": "mrcp.copyAiContext",
        "title": "MRCP: Copiar Contexto Otimizado para IA (Tokens 95% Menores)",
        "icon": "$(copy)"
      },
      {
        "command": "mrcp.copyFileContext",
        "title": "MRCP: Copiar Assinatura / Contexto do Arquivo Ativo para IA",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "mrcp.auditSecurity",
        "title": "MRCP: Auditar Segurança e Segredos (.env)",
        "icon": "$(shield)"
      },
      {
        "command": "mrcp.detectDeadCode",
        "title": "MRCP: Detectar Código Morto & Exports Não Utilizados",
        "icon": "$(trash)"
      },
      {
        "command": "mrcp.validateEnv",
        "title": "MRCP: Validar Variáveis de Ambiente vs Código",
        "icon": "$(key)"
      },
      {
        "command": "mrcp.exportReport",
        "title": "MRCP: Exportar Relatório Diagnóstico Consolidado (.md)",
        "icon": "$(markdown)"
      },
      {
        "command": "mrcp.refresh",
        "title": "MRCP: Atualizar Análise",
        "icon": "$(refresh)"
      },
      {
        "command": "mrcp.openFileAtLocation",
        "title": "MRCP: Abrir Localização no Código"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mrcp.refresh",
          "when": "view =~ /^mrcp\\.views\\./",
          "group": "navigation@1"
        },
        {
          "command": "mrcp.runFullSuite",
          "when": "view =~ /^mrcp\\.views\\./",
          "group": "navigation@2"
        },
        {
          "command": "mrcp.openDashboard",
          "when": "view =~ /^mrcp\\.views\\./",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "mrcp.copyFileContext",
          "group": "MRCP@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "MRCP Engine",
      "properties": {
        "mrcp.autoAnalyzeOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Executa análise incremental leve ao salvar arquivos de código."
        },
        "mrcp.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Exibe indicadores de complexidade ciclomática e atalhos para IA acima de funções e classes."
        },
        "mrcp.enableNativeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Publica alertas de segurança e variáveis ausentes no painel de Problemas do VS Code."
        },
        "mrcp.maxFiles": {
          "type": "number",
          "default": 2000,
          "description": "Limite máximo de arquivos para escaneamento no workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^22.16.5",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.8.3"
  }
}
