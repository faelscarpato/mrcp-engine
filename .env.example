# MRCP Cognitive Runtime - Environment Variables
# Copie este arquivo para .env antes de fazer o deploy

# Chave de autenticação para o endpoint MRCP
MRCP_API_KEY=your_mrcp_api_key_here

# Chave da API do Google Gemini para o LLM Executor
GEMINI_API_KEY=your_gemini_api_key_here

# Ambiente de execução
NODE_ENV=production