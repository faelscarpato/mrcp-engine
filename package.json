{
  "name": "mrcp-engine",
  "version": "2.7.3",
  "description": "Deterministic AST code-intelligence engine for AI agents — MCP server + REST API for architecture analysis, security audits, and doc generation.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm-tools",
    "ast",
    "code-analysis",
    "tree-sitter",
    "developer-tools",
    "typescript",
    "openapi",
    "static-analysis",
    "code-intelligence"
  ],
  "homepage": "https://mrcp-engine.vercel.app",
  "bugs": {
    "url": "https://github.com/faelscarpato/mrcp-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/faelscarpato/mrcp-engine.git"
  },
  "license": "MIT",
  "author": "faelscarpato",
  "private": false,
  "workspaces": [
    "packages/*",
    "apps/*",
    "api"
  ],
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "build:grammar": "node scripts/build-grammar.mjs",
    "build:core": "tsc -p packages/core/tsconfig.build.json",
    "build:cli": "tsc -p packages/cli/tsconfig.json",
    "prepack": "npm run build:core && npm run build:cli",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "bin": {
    "mrcp": "bin/mrcp.js",
    "mrcp-engine": "bin/mrcp.js",
    "mrcp-auto": "bin/mrcp-autonomous.ts"
  },
  "files": [
    "bin/",
    "packages/cli/bin/",
    "packages/cli/dist/",
    "packages/cli/mcp-server.mjs",
    "packages/cli/mcp-handlers.mjs",
    "packages/cli/mcp-tools.mjs",
    "packages/cli/package.json",
    "packages/cli/README.md",
    "packages/core/dist/",
    "packages/core/package.json",
    "api/",
    "src/",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "!packages/**/lib/",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "date-fns": "^4.1.0",
    "tsx": "^4.23.12",
    "web-tree-sitter": "^0.26.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@vercel/node": "^5.9.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.3",
    "puppeteer": "^25.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": true,
    "opencode-ai": true,
    "puppeteer": true,
    "tree-sitter-c": false,
    "tree-sitter-cobol": false,
    "tree-sitter-cpp": false,
    "tree-sitter-go": false,
    "tree-sitter-java": false,
    "tree-sitter-javascript": false,
    "tree-sitter-php": false,
    "tree-sitter-python": false,
    "tree-sitter-ruby": false,
    "tree-sitter-rust": false,
    "tree-sitter-typescript": false
  },
  "optionalDependencies": {
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cobol": "^0.0.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  }
}
